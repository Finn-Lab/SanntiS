// Defaults for nf/tasks.nf. No executor and no site profiles: infrastructure comes from the user's own
// config (--nf-config / --nf-profile), which is passed after this file and wins. The only profiles here are
// the container engines, and they only set the antiSMASH container (our own steps run in the host env).
// The nf-core antiSMASH 8.0.1 image ships its HMM data hmmpress-ed (the plain biocontainer does not, and
// cannot press them in a read-only Singularity image); databases come from --antismash-databases.

process {
    withLabel: cpu_small {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }
    withLabel: train {
        cpus   = 8
        memory = '32 GB'
        time   = '48h'
    }
    withLabel: gpu {
        cpus   = 8
        memory = '32 GB'
        time   = '48h'
    }
    withLabel: antismash {
        cpus   = 4
        memory = '16 GB'
        time   = '24h'
    }
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process {
            withLabel: antismash {
                container = 'quay.io/nf-core/antismash:8.0.1--pyhdfd78af_0'
            }
        }
    }
    podman {
        podman.enabled = true
        process {
            withLabel: antismash {
                container = 'quay.io/nf-core/antismash:8.0.1--pyhdfd78af_0'
            }
        }
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            withLabel: antismash {
                container = 'quay.io/nf-core/antismash:8.0.1--pyhdfd78af_0'
            }
        }
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        process {
            withLabel: antismash {
                container = 'quay.io/nf-core/antismash:8.0.1--pyhdfd78af_0'
            }
        }
    }
}
